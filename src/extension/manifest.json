{
  "name": "GetANNY · Browser Assistant",
  "version": "2.1.0",
  "description": "Send files and supported media pages to your GetANNY desktop download manager. Authenticated native connection and explicit user control.",
  "permissions": [
    "storage",
    "tabs",
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "cookies",
    "webRequest"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js", "injector.js"],
      "run_at": "document_idle"
    }
  ],
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "key": "",
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GetANNY",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
